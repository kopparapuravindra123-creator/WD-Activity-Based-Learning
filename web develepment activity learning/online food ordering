<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}
body {
    font-family: Arial, sans-serif;
    background: #f0f4f8;
}
/* Header */
header {
    background: #101c3a;
    color: white;
    padding: 22px;
    text-align: center;
}
/* Navigation */
nav {
    background: #2455a4;
    padding: 16px;
    text-align: center;
    position: sticky;
    top: 0;
}
nav a {
    color: white;
    text-decoration: none;
    margin: 12px;
    font-weight: bold;
    transition: 0.3s;
}
nav a:hover {
    color: yellow;
    border-bottom: 2px solid yellow;
}
/* Profile */
.profile {
    text-align: center;
    padding: 45px 20px;
    background: linear-gradient(120deg, #142b55, #3984c6);
    color: white;
    animation: fadein 2s;
}
.profile img {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    border: 5px solid white;
    object-fit: cover;
}
.profile h1 {
    margin: 15px;
    font-size: 35px;
}
/* Animation */
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
/* Sections */
.section {
    padding: 35px 20px;
    text-align: center;
}
.section h2 {
    color: #174477;
    margin-bottom: 25px;
}
/* Cards */
.container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
}
.card {
    background: white;
    width: 260px;
    padding: 22px;
    border-radius: 12px;
    box-shadow: 0 3px 12px #bbb;
    transition: 0.4s;
}
.card:hover {
    transform: translateY(-10px);
    box-shadow: 0 6px 18px #888;
}
.card h3 {
    color: #2455a4;
    margin-bottom: 12px;
}
/* Skills */
.skill {
    background: #dce5f0;
    margin: 12px auto;
    width: 80%;
    height: 15px;
    border-radius: 10px;
}
.skill-bar {
    background: #2455a4;
    height: 15px;
    border-radius: 10px;
}
button {
    background: #2455a4;
    color: white;
    padding: 12px 25px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
}
button:hover {
    background: #101c3a;
}
/* Contact */
.contact {
    background: #dceaff;
    padding: 35px;
    text-align: center;
}
/* Footer */
footer {
    background: #101c3a;
    color: white;
    text-align: center;
    padding: 20px;
}
/* Mobile Responsive */
    .profile h1 {
        font-size: 27px;
    }
    .card {
        width: 100%;
    }
    .skill {
        width: 95%;
    }
</style>
</head>
